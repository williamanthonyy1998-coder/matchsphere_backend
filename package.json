{
  "name": "matchsphere-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "build": "npm run prisma:generate && node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "postinstall": "npm run prisma:generate",
    "vercel-build": "npm run prisma:generate && node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "db:generate": "npm run prisma:generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
