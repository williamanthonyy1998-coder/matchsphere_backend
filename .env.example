DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"
PORT=5000
# Comma-separated browser origins allowed for CORS (no wildcard with credentials).
# Production frontend is also allowlisted in code; keep this in sync on Vercel.
CORS_ORIGIN="http://localhost:5173,https://matchspheredashboard-dist.vercel.app"

# Local development admin seed credentials (change before sharing/deployment)
MATCHSPHERE_ADMIN_EMAIL="admin@matchsphere.com"
MATCHSPHERE_ADMIN_PASSWORD="ChangeMe_AdminPassword!"

# Synthetic demo seller accounts (local development only)
MATCHSPHERE_DEMO_PASSWORD="ChangeMe_DemoPassword!"
